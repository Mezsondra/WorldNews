{
  "name": "worldnews",
  "version": "1.0.0",
  "description": "A manual-first, source-linked world news production desk",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "ui": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "worker": "tsx --env-file-if-exists=.env server/worker-entry.ts",
    "demo": "tsx --env-file-if-exists=.env server/demo.ts",
    "format": "prettier --write src server shared tests",
    "pilot": "tsx --env-file-if-exists=.env server/pilot.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "private": true,
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
