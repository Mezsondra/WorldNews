# Local development needs no credentials. Node 24.13+ and FFmpeg required.
HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
# Optional PostgreSQL; otherwise a local SQLite database is used.
# DATABASE_URL=postgresql://worldnews:change-me@localhost:5432/worldnews
# Required when listening on a non-loopback interface; use a long random secret.
# DASHBOARD_PASSWORD=
# Stable public origin for exported citations; no server is published automatically.
PUBLIC_BASE_URL=http://localhost:4310
# macOS uses say. Linux uses espeak-ng. Both are development voices.
TTS_PROVIDER=local
# Existing-account integrations. Keys stay on the backend.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ASSEMBLYAI_API_KEY=
# A pilot is disabled by default. Set a user-chosen combined credit allowance.
PILOT_API_ENABLED=false
PILOT_BUDGET_USD=0
# TTS_PROVIDER=gemini
GEMINI_VOICE=Kore
# CAPTIONS_PROVIDER=assemblyai
CAPTIONS_PROVIDER=estimated
# Automatic private previews search Commons for credited archive/context photos.
MEDIA_DISCOVERY_ENABLED=true
# Licensed production voice is optional; setting these enables paid narration.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# MAX_PAID_CHARACTERS_PER_RENDER=1500
